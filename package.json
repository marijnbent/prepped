{
  "name": "prepped",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12 <27"
  },
  "scripts": {
    "dev": "portless prepped npm run watch",
    "watch": "NODE_ENV=development astro dev --host 127.0.0.1",
    "dev:clean": "rm -rf node_modules/.vite && portless prepped npm run watch -- --force",
    "build": "astro build",
    "db:baseline": "node scripts/baseline-drizzle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "check": "npm run check:types && npm run check:client-boundaries",
    "check:types": "astro check",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "test": "tsx --test test/*.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "seed": "npx tsx scripts/seed-test-user.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.104",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mozilla/readability": "^0.6.0",
    "ai": "^6.0.270",
    "astro": "^7.2.8",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.574.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
