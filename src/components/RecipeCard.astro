---
import { t } from "../lib/i18n";
import { formatStepDuration } from "../lib/recipe-export";
import FavoriteButton from "../islands/FavoriteButton";

interface Props {
  recipe: {
    id: number;
    title: string;
    slug: string;
    description?: string | null;
    imageUrl?: string | null;
    prepTime?: number | null;
    cookTime?: number | null;
    difficulty?: string | null;
    authorName?: string | null;
  };
  href?: string;
  isFavorited?: boolean;
  showFavorite?: boolean;
}

const { recipe, href, isFavorited = false, showFavorite = false } = Astro.props;
const totalTime = (recipe.prepTime || 0) + (recipe.cookTime || 0);
const link = href || `/recipes/${recipe.slug}`;
const imageSrc = recipe.imageUrl?.startsWith("/") ? `/api/uploads${recipe.imageUrl}` : recipe.imageUrl;
const meta = [
  totalTime > 0 && formatStepDuration(totalTime, t("recipe.minutes"), t("recipe.hours")),
  recipe.difficulty && t(`recipe.${recipe.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard").toLocaleLowerCase(),
  recipe.authorName,
]
  .filter(Boolean)
  .join(", ");
---

<div class="group min-w-0">
  <a href={link} class="block aspect-[4/3] rounded-[20px] overflow-hidden bg-secondary" aria-label={recipe.title}>
    {imageSrc && (
      <img
        src={imageSrc}
        alt={recipe.title}
        class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
        loading="lazy"
      />
    )}
  </a>
  <div class="flex items-start justify-between gap-3 mt-4">
    <a href={link} class="min-w-0 hover:underline underline-offset-4">
      <h3 class="text-xl font-medium tracking-[-0.025em] leading-tight line-clamp-2">{recipe.title}</h3>
    </a>
    {showFavorite && <FavoriteButton recipeId={recipe.id} initialFavorited={isFavorited} client:load />}
  </div>
  {meta && <p class="text-sm text-muted-foreground mt-2">{meta}</p>}
</div>
