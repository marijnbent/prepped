---
import { t } from "../lib/i18n";
import Wordmark from "./Wordmark.astro";

const navLinks = [
  { href: "/recipes", label: t("nav.recipes") },
  { href: "/collections", label: t("nav.collections") },
  { href: "/cook-log", label: t("nav.cookLog") },
];

const year = new Date().getFullYear();
---

<footer class="mt-auto hidden lg:block border-t border-border">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="max-w-6xl mx-auto py-10 flex items-start justify-between gap-8">
      <div>
        <a href="/" class="text-xl"><Wordmark /></a>
        <p class="text-sm text-muted-foreground mt-2 max-w-xs">{t("site.description")}</p>
        <p class="text-xs text-muted-foreground mt-4">&copy; {year} Prepped</p>
      </div>
      <nav class="flex flex-wrap gap-6 text-sm text-muted-foreground">
        {navLinks.map((link) => (
          <a href={link.href} class="hover:underline underline-offset-4">{link.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>
