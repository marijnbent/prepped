---
import RecipeCard from "./RecipeCard.astro";
import { t } from "../lib/i18n";

interface Props {
  recipes: {
    id: number;
    title: string;
    slug: string;
    description?: string | null;
    imageUrl?: string | null;
    prepTime?: number | null;
    cookTime?: number | null;
    difficulty?: string | null;
    href?: string;
  }[];
  emptyTitle?: string;
  emptyHint?: string;
}

const { recipes, emptyTitle = t("recipe.noRecipes"), emptyHint = t("recipe.emptyHint") } = Astro.props;
---

{recipes.length === 0 ? (
  <div class="py-16">
    <p class="text-xl font-medium">{emptyTitle}</p>
    <p class="text-muted-foreground mt-2">{emptyHint}</p>
  </div>
) : (
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
    {recipes.map((recipe) => <RecipeCard recipe={recipe} href={recipe.href} />)}
  </div>
)}
