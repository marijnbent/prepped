---
import { Search } from "lucide-react";
import { t } from "../lib/i18n";
import Wordmark from "./Wordmark.astro";
import UserMenu from "../islands/UserMenu";
import ThemeToggle from "../islands/ThemeToggle";
import NotificationMenu from "../islands/NotificationMenu";

interface Props {
  user?: { id: string; name: string; email: string } | null;
}

const { user } = Astro.props;
const pathname = Astro.url.pathname;
const authMode = import.meta.env.AUTH_MODE || "password";
const isEditPage = /\/edit$/.test(pathname);

const primaryNav = [
  { href: "/recipes", label: t("nav.recipes") },
  { href: "/shopping-list", label: t("nav.shoppingList") },
  { href: "/collections", label: t("nav.collections") },
  { href: "/users", label: t("nav.community") },
];
---

<header class="sticky top-0 z-50 bg-background">
  <div class="container mx-auto px-4 sm:px-6">
    <div class="max-w-6xl mx-auto h-20 flex items-center justify-between gap-4">
      <div class="flex items-center gap-8">
        <a href="/" class="text-[28px]"><Wordmark /></a>
        <nav class="hidden lg:flex items-center gap-6">
          {primaryNav.map((link) => (
            <a
              href={link.href}
              aria-current={pathname.startsWith(link.href) ? "page" : undefined}
              class:list={[
                "text-[15px] hover:underline underline-offset-4",
                pathname.startsWith(link.href) ? "text-foreground font-medium" : "text-muted-foreground",
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
      <div class="hidden lg:flex items-center gap-2">
        <a
          href="/recipes?search="
          class="inline-flex items-center justify-center rounded-full w-10 h-10 text-muted-foreground hover:bg-secondary"
          aria-label={t("common.search")}
        >
          <Search size={18} strokeWidth={2} />
        </a>
        {user && !isEditPage && (
          <a href="/recipes/new" class="rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
            {t("nav.newRecipe")}
          </a>
        )}
        {user && <NotificationMenu client:load />}
        <ThemeToggle client:load />
        <UserMenu user={user} authMode={authMode} client:load />
      </div>
      <div class="lg:hidden flex items-center">
        {user && <NotificationMenu client:load />}
        <ThemeToggle client:load />
      </div>
    </div>
  </div>
</header>
