---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["wordmark", className]}>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <path d="M30 6C42 4 50 12 54 20C60 30 60 42 52 50C44 58 34 56 26 58C16 60 6 52 6 40C6 32 12 28 14 20C16 12 22 7 30 6Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
    <circle cx="35" cy="31" r="11" fill="#ffe45c" />
  </svg>
  <span>prepped</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
    white-space: nowrap;
  }

  svg {
    width: 1em;
    height: 1em;
    transform: translateY(0.1em);
    flex: none;
  }
</style>
