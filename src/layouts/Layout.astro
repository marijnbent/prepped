---
import "../styles/globals.css";
import { Font } from "astro:assets";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileToolbar from "../islands/MobileToolbar";
import { t, locale } from "../lib/i18n";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const pageTitle = title ? `${title} - ${t("site.title")}` : t("site.title");
const pageDescription = description || t("site.description");
const canonicalUrl = Astro.url.href;
const user = Astro.locals.user;
const analyticsIdentity = user ? { id: user.id, name: user.name } : null;
const authMode = import.meta.env.AUTH_MODE || "password";
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    {/* PWA */}
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f4f0" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <Font cssVariable="--font-outfit" preload />

    {/* Open Graph */}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}

    <title>{pageTitle}</title>

    <script defer src="https://analytics.cowsandbytes.com/script.js" data-website-id="e8fddee2-6f80-4f83-b92e-fd4ba0eba6e1"></script>
    {analyticsIdentity && (
      <script is:inline define:vars={{ analyticsIdentity }}>
        (function() {
          function identify(attemptsLeft) {
            if (window.umami && typeof window.umami.identify === "function") {
              window.umami.identify(analyticsIdentity);
              return;
            }

            if (attemptsLeft > 0) {
              window.setTimeout(function() {
                identify(attemptsLeft - 1);
              }, 200);
            }
          }

          identify(25);
        })();
      </script>
    )}

    {/* Prevent flash of wrong theme */}
    <script is:inline>
      (function() {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col antialiased font-sans">
    <Header user={user} />
    <main class="flex-1 w-full pb-20 lg:pb-0">
      <div class="container mx-auto px-4 sm:px-6 py-6 md:py-10">
        <slot />
      </div>
    </main>
    <Footer />
    {user && (
      <MobileToolbar user={user} pathname={pathname} authMode={authMode} client:load />
    )}
  </body>
</html>
