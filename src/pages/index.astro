---
import Layout from "../layouts/Layout.astro";
import { formatStepDuration } from "../lib/recipe-export";
import RecipeCard from "../components/RecipeCard.astro";
import { db } from "../lib/db";
import { recipes, cookLogs, users } from "../lib/schema";
import { desc, eq, count, ne, and } from "drizzle-orm";
import { t, formatDate } from "../lib/i18n";

const user = Astro.locals.user;

// Stats (always shown)
const totalRecipes = db.select({ count: count() }).from(recipes).where(eq(recipes.isPublished, true)).get()!.count;
const totalLogs = db.select({ count: count() }).from(cookLogs).get()!.count;
const totalMembers = db.select({ count: count() }).from(users).get()!.count;

// Logged-in data
let myRecipes: (typeof recipes.$inferSelect)[] = [];
let communityRecipes: (Pick<typeof recipes.$inferSelect, "id" | "title" | "slug" | "description" | "imageUrl" | "prepTime" | "cookTime" | "difficulty" | "createdBy"> & { authorName: string })[] = [];
let recentLogs: (Pick<typeof cookLogs.$inferSelect, "id" | "photoUrl" | "notes" | "rating" | "cookedAt"> & { recipeTitle: string; recipeSlug: string; recipeOwnerId: string; recipeImageUrl: string | null; authorName: string | null })[] = [];

if (user) {
  // One featured recipe plus two full rows of three
  myRecipes = db
    .select()
    .from(recipes)
    .where(and(eq(recipes.isPublished, true), eq(recipes.createdBy, user.id)))
    .orderBy(desc(recipes.createdAt))
    .limit(7)
    .all();

  communityRecipes = db
    .select({
      id: recipes.id,
      title: recipes.title,
      slug: recipes.slug,
      description: recipes.description,
      imageUrl: recipes.imageUrl,
      prepTime: recipes.prepTime,
      cookTime: recipes.cookTime,
      difficulty: recipes.difficulty,
      createdBy: recipes.createdBy,
      authorName: users.name,
    })
    .from(recipes)
    .innerJoin(users, eq(recipes.createdBy, users.id))
    .where(and(eq(recipes.isPublished, true), ne(recipes.createdBy, user.id)))
    .orderBy(desc(recipes.createdAt))
    .limit(6)
    .all();

  recentLogs = db
    .select({
      id: cookLogs.id,
      photoUrl: cookLogs.photoUrl,
      notes: cookLogs.notes,
      rating: cookLogs.rating,
      cookedAt: cookLogs.cookedAt,
      recipeTitle: recipes.title,
      recipeSlug: recipes.slug,
      recipeOwnerId: recipes.createdBy,
      recipeImageUrl: recipes.imageUrl,
      authorName: users.name,
    })
    .from(cookLogs)
    .innerJoin(recipes, eq(cookLogs.recipeId, recipes.id))
    .leftJoin(users, eq(cookLogs.createdBy, users.id))
    .where(eq(cookLogs.createdBy, user.id))
    .orderBy(desc(cookLogs.cookedAt))
    .limit(4)
    .all();
} else {
  // Logged-out: show all recent for the landing
  communityRecipes = db
    .select({
      id: recipes.id,
      title: recipes.title,
      slug: recipes.slug,
      description: recipes.description,
      imageUrl: recipes.imageUrl,
      prepTime: recipes.prepTime,
      cookTime: recipes.cookTime,
      difficulty: recipes.difficulty,
      createdBy: recipes.createdBy,
      authorName: users.name,
    })
    .from(recipes)
    .innerJoin(users, eq(recipes.createdBy, users.id))
    .where(eq(recipes.isPublished, true))
    .orderBy(desc(recipes.createdAt))
    .limit(6)
    .all();
}

const firstName = user?.name?.split(" ")[0] || "";
const featured = myRecipes[0];
const otherRecipes = myRecipes.slice(1);

const stats = [
  { label: t("nav.recipes"), value: totalRecipes },
  { label: t("home.members"), value: totalMembers },
  { label: t("home.cooked"), value: totalLogs },
];

const imageSrc = (url: string) => (url.startsWith("/") ? `/api/uploads${url}` : url);

const recipeMeta = (recipe: { prepTime: number | null; cookTime: number | null; difficulty: string | null }) => {
  const totalTime = (recipe.prepTime || 0) + (recipe.cookTime || 0);
  return [
    totalTime > 0 && formatStepDuration(totalTime, t("recipe.minutes"), t("recipe.hours")),
    recipe.difficulty && t(`recipe.${recipe.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard").toLocaleLowerCase(),
  ]
    .filter(Boolean)
    .join(", ");
};

// Community recipe pages need a session, so send visitors through login first
const communityHref = (recipe: { createdBy: string; slug: string }) => {
  const path = `/users/${recipe.createdBy}/recipes/${recipe.slug}`;
  return user ? path : `/login?redirect=${encodeURIComponent(path)}`;
};

const pill = "inline-flex rounded-full px-[18px] py-[9px] font-medium";
const pillPrimary = `${pill} bg-primary text-primary-foreground`;
const pillOutline = `${pill} border-[1.5px] border-foreground hover:bg-secondary`;
const sectionLink = "text-sm text-muted-foreground hover:underline underline-offset-4";
---

<Layout>
  <div class="max-w-6xl mx-auto">
    {user ? (
      <>
        <section class="pt-5 pb-12 md:pt-8 md:pb-16">
          <h1 class="text-4xl md:text-6xl font-medium tracking-[-0.04em] leading-none">
            {t("home.welcome")}, {firstName}
          </h1>
        </section>

        {featured ? (
          <section class="mb-20">
            <div class="flex items-end justify-between gap-4 mb-7">
              <h2 class="text-2xl font-medium tracking-tight">{t("nav.recipes")}</h2>
              <a href="/recipes" class={sectionLink}>{t("home.viewAll")}</a>
            </div>

            <div class:list={["grid gap-8 md:gap-12 items-center mb-12", featured.imageUrl && "md:grid-cols-[1.2fr_1fr]"]}>
              {featured.imageUrl && (
                <a href={`/recipes/${featured.slug}`} class="block rounded-[20px] overflow-hidden aspect-[4/3]">
                  <img src={imageSrc(featured.imageUrl)} alt={featured.title} class="w-full h-full object-cover" />
                </a>
              )}
              <div class="md:py-6">
                <h3 class="text-4xl lg:text-5xl font-medium tracking-[-0.04em] leading-none">
                  <a href={`/recipes/${featured.slug}`} class="hover:underline underline-offset-4">{featured.title}</a>
                </h3>
                <p class="text-muted-foreground mt-4">{recipeMeta(featured)}</p>
                {featured.description && (
                  <p class="mt-5 text-muted-foreground leading-relaxed line-clamp-3 max-w-lg">{featured.description}</p>
                )}
                <a href={`/recipes/${featured.slug}`} class:list={[pillOutline, "mt-7 text-sm"]}>{t("recipe.open")}</a>
              </div>
            </div>

            {otherRecipes.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
                {otherRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
              </div>
            )}
          </section>
        ) : (
          <section class="mb-20">
            <h2 class="text-3xl font-medium tracking-tight">{t("home.emptyTitle")}</h2>
            <p class="text-muted-foreground mt-3 max-w-lg">{t("home.emptyDesc")}</p>
            <div class="flex flex-wrap gap-3 mt-6">
              <a href="/recipes/new" class:list={[pillPrimary, "text-sm"]}>{t("home.addRecipe")}</a>
              <a href="/users" class:list={[pillOutline, "text-sm"]}>{t("home.browseCommunity")}</a>
            </div>
          </section>
        )}

        {recentLogs.length > 0 && (
          <section class="mb-20">
            <div class="flex items-end justify-between gap-4 mb-2">
              <h2 class="text-2xl font-medium tracking-tight">{t("cookLog.title")}</h2>
              <a href="/cook-log" class={sectionLink}>{t("home.viewAll")}</a>
            </div>
            <div class="divide-y divide-border">
              {recentLogs.map((log) => (
                <a
                  href={log.recipeOwnerId === user.id ? `/recipes/${log.recipeSlug}` : `/users/${log.recipeOwnerId}/recipes/${log.recipeSlug}`}
                  class="group flex items-start gap-5 py-5"
                >
                  {log.photoUrl && (
                    <img src={imageSrc(log.photoUrl)} alt="" class="w-20 h-20 rounded-[20px] object-cover" loading="lazy" />
                  )}
                  <div class="min-w-0 flex-1">
                    <h3 class="font-medium group-hover:underline underline-offset-4">{log.recipeTitle}</h3>
                    {log.notes && <p class="text-muted-foreground mt-1 line-clamp-2">{log.notes}</p>}
                    <p class="text-sm text-muted-foreground mt-2">
                      <time>{formatDate(log.cookedAt)}</time>{log.rating && `, ${log.rating}/5`}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </>
    ) : (
      <>
        <section class="pt-12 pb-16 md:pt-20 md:pb-20">
          <h1 class="text-lg md:text-xl text-muted-foreground max-w-lg leading-relaxed">{t("home.heroDesc")}</h1>
          <div class="flex flex-wrap gap-3 mt-8">
            <a href="/register" class={pillPrimary}>{t("home.getStarted")}</a>
            <a href="/login" class={pillOutline}>{t("auth.login")}</a>
          </div>
        </section>

        <section class="grid grid-cols-3 gap-6 max-w-xl mb-20">
          {stats.map((stat) => (
            <div>
              <p class="text-4xl md:text-5xl font-medium tracking-[-0.04em]">{stat.value}</p>
              <p class="text-sm text-muted-foreground mt-2">{stat.label}</p>
            </div>
          ))}
        </section>
      </>
    )}

    {communityRecipes.length > 0 && (
      <section class="mb-16">
        <div class="flex items-end justify-between gap-4 mb-7">
          <h2 class="text-2xl font-medium tracking-tight">{user ? t("nav.community") : t("home.whatsCooking")}</h2>
          {user && <a href="/users" class={sectionLink}>{t("home.allMembers")}</a>}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
          {communityRecipes.map((recipe) => <RecipeCard recipe={recipe} href={communityHref(recipe)} />)}
        </div>
        {!user && (
          <a href="/register" class="inline-block mt-10 font-medium hover:underline underline-offset-4">
            {t("home.signUpCta")}
          </a>
        )}
      </section>
    )}
  </div>
</Layout>
