---
import Layout from "../../layouts/Layout.astro";
import { db } from "../../lib/db";
import { collections, favorites, recipeCollections, recipes } from "../../lib/schema";
import { eq, count, desc, and, inArray, isNotNull } from "drizzle-orm";
import PageHeader from "../../components/PageHeader.astro";
import { Heart } from "lucide-react";
import { t } from "../../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/collections");
}

const allCollections = db
  .select()
  .from(collections)
  .where(eq(collections.createdBy, Astro.locals.user.id))
  .orderBy(collections.sortOrder)
  .all();
const collectionIds = allCollections.map((col) => col.id);

// Get recipe counts
const counts = collectionIds.length === 0
  ? []
  : db
      .select({
        collectionId: recipeCollections.collectionId,
        count: count(),
      })
      .from(recipeCollections)
      .where(inArray(recipeCollections.collectionId, collectionIds))
      .groupBy(recipeCollections.collectionId)
      .all();

const countsMap = new Map(counts.map((c) => [c.collectionId, c.count]));

// Sort collections by recipe count (descending)
allCollections.sort((a, b) => (countsMap.get(b.id) || 0) - (countsMap.get(a.id) || 0));

// Get up to 4 recent recipe images per collection for the thumbnail grid
const thumbsMap = new Map<number, string[]>();
const collectionsNeedingThumbs = allCollections.filter((col) => !col.imageUrl).map((col) => col.id);
if (collectionsNeedingThumbs.length > 0) {
  const thumbRows = db
    .select({
      collectionId: recipeCollections.collectionId,
      imageUrl: recipes.imageUrl,
    })
    .from(recipeCollections)
    .innerJoin(recipes, eq(recipeCollections.recipeId, recipes.id))
    .where(and(inArray(recipeCollections.collectionId, collectionsNeedingThumbs), isNotNull(recipes.imageUrl)))
    .orderBy(recipeCollections.collectionId, desc(recipes.createdAt))
    .all();

  for (const row of thumbRows) {
    if (!row.imageUrl) continue;
    const existing = thumbsMap.get(row.collectionId) || [];
    if (existing.length >= 4) continue;
    existing.push(row.imageUrl);
    thumbsMap.set(row.collectionId, existing);
  }
}

const favoriteCount = db
  .select({ count: count() })
  .from(favorites)
  .where(eq(favorites.userId, Astro.locals.user.id))
  .get()!.count;

const uploadSrc = (url: string) => (url.startsWith("/") ? `/api/uploads${url}` : url);
const recipeCountLabel = (n: number) => `${n} ${n === 1 ? t("count.recipe") : t("count.recipes")}`;
---

<Layout title={t("nav.collections")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("nav.collections")} count={allCollections.length}>
      <a slot="actions" href="/collections/new" class="inline-flex rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
        {t("collection.new")}
      </a>
    </PageHeader>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
      <a href="/favorites" class="group block min-w-0">
        <div class="aspect-[4/3] rounded-[20px] bg-highlight text-highlight-foreground flex items-center justify-center">
          <Heart size={44} strokeWidth={1.75} fill="currentColor" />
        </div>
        <h2 class="mt-4 text-xl font-medium tracking-[-0.025em] leading-tight group-hover:underline underline-offset-4">
          {t("collection.favorites")}
        </h2>
        <p class="text-sm text-muted-foreground mt-2">{recipeCountLabel(favoriteCount)}</p>
      </a>

      {allCollections.map((col) => {
        const thumbs = thumbsMap.get(col.id) || [];
        return (
          <a href={`/collections/${col.slug}`} class="group block min-w-0">
            <div class="aspect-[4/3] rounded-[20px] overflow-hidden bg-secondary">
              {col.imageUrl ? (
                <img
                  src={uploadSrc(col.imageUrl)}
                  alt=""
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                  loading="lazy"
                />
              ) : thumbs.length > 0 && (
                <div class:list={["grid h-full gap-0.5", thumbs.length > 1 && "grid-cols-2", thumbs.length > 2 && "grid-rows-2"]}>
                  {thumbs.map((img, i) => (
                    <img
                      src={uploadSrc(img)}
                      alt=""
                      class:list={["w-full h-full min-h-0 object-cover", thumbs.length === 3 && i === 0 && "row-span-2"]}
                      loading="lazy"
                    />
                  ))}
                </div>
              )}
            </div>
            <h2 class="mt-4 text-xl font-medium tracking-[-0.025em] leading-tight line-clamp-2 group-hover:underline underline-offset-4">
              {col.name}
            </h2>
            <p class="text-sm text-muted-foreground mt-2">{recipeCountLabel(countsMap.get(col.id) || 0)}</p>
          </a>
        );
      })}
    </div>

    {allCollections.length === 0 && (
      <div class="mt-14 border-t border-border pt-8">
        <p class="text-xl font-medium">{t("collection.noCustom")}</p>
        <p class="text-muted-foreground mt-2">{t("collection.emptyHint")}</p>
      </div>
    )}
  </div>
</Layout>
