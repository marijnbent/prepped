---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import CollectionForm from "../../islands/CollectionForm";
import { t } from "../../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/collections/new");
}
---

<Layout title={t("collection.new")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("collection.new")} back={{ href: "/collections", label: t("nav.collections") }} />
    <CollectionForm client:load />
  </div>
</Layout>
