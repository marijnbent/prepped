---
import Layout from "../../../layouts/Layout.astro";
import CollectionForm from "../../../islands/CollectionForm";
import { db } from "../../../lib/db";
import { collections } from "../../../lib/schema";
import { eq, and } from "drizzle-orm";
import PageHeader from "../../../components/PageHeader.astro";
import { t } from "../../../lib/i18n";

const { slug } = Astro.params;

if (!Astro.locals.user) {
  return Astro.redirect(`/login?redirect=/collections/${slug}/edit`);
}

const collection = db
  .select()
  .from(collections)
  .where(and(eq(collections.slug, slug!), eq(collections.createdBy, Astro.locals.user.id)))
  .get();
if (!collection) {
  return Astro.redirect("/collections");
}
---

<Layout title={`${t("collection.editPrefix")} - ${collection.name}`}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("collection.editPrefix")} back={{ href: `/collections/${collection.slug}`, label: collection.name }} />
    <CollectionForm
      initial={{
        id: collection.id,
        name: collection.name,
        description: collection.description || "",
        imageUrl: collection.imageUrl || "",
        sortOrder: collection.sortOrder,
      }}
      client:load
    />
  </div>
</Layout>
