---
import Layout from "../../layouts/Layout.astro";
import RecipeGrid from "../../components/RecipeGrid.astro";
import { db } from "../../lib/db";
import { collections, recipeCollections, recipes } from "../../lib/schema";
import { eq, and } from "drizzle-orm";
import PageHeader from "../../components/PageHeader.astro";
import { Pencil, Trash2 } from "lucide-react";
import { t } from "../../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/collections");
}

const { slug } = Astro.params;
const collection = db
  .select()
  .from(collections)
  .where(and(eq(collections.slug, slug!), eq(collections.createdBy, Astro.locals.user.id)))
  .get();
if (!collection) {
  return Astro.redirect("/collections");
}

const collectionRecipesRaw = db
  .select({
    id: recipes.id,
    title: recipes.title,
    slug: recipes.slug,
    description: recipes.description,
    imageUrl: recipes.imageUrl,
    prepTime: recipes.prepTime,
    cookTime: recipes.cookTime,
    difficulty: recipes.difficulty,
    createdBy: recipes.createdBy,
  })
  .from(recipeCollections)
  .innerJoin(recipes, eq(recipeCollections.recipeId, recipes.id))
  .where(eq(recipeCollections.collectionId, collection.id))
  .all();

const collectionRecipes = collectionRecipesRaw.map((r) => ({
  ...r,
  href: r.createdBy === Astro.locals.user!.id
    ? `/recipes/${r.slug}`
    : `/users/${r.createdBy}/recipes/${r.slug}`,
}));
---

<Layout title={collection.name}>
  <div class="max-w-6xl mx-auto">
    <PageHeader
      title={collection.name}
      count={collectionRecipes.length}
      description={collection.description}
      back={{ href: "/collections", label: t("nav.collections") }}
    >
      <Fragment slot="actions">
        <a
          href={`/collections/${collection.slug}/edit`}
          class="inline-flex items-center gap-2 rounded-full border-[1.5px] border-foreground px-[18px] py-[9px] text-sm font-medium hover:bg-secondary"
        >
          <Pencil size={16} strokeWidth={2} />
          {t("common.edit")}
        </a>
        <button
          id="delete-collection"
          type="button"
          data-id={collection.id}
          data-confirm={t("collection.deleteConfirm")}
          data-error={t("common.error")}
          aria-label={t("common.delete")}
          class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-border text-destructive hover:bg-secondary cursor-pointer"
        >
          <Trash2 size={16} strokeWidth={2} className="pointer-events-none" />
        </button>
      </Fragment>
    </PageHeader>
    <RecipeGrid
      recipes={collectionRecipes}
      emptyTitle={t("collection.empty")}
      emptyHint={t("collection.addRecipesHint")}
    />
  </div>

  <script is:inline>
    document.addEventListener("click", async (e) => {
      const btn = e.target.closest("#delete-collection");
      if (!btn) return;
      if (!confirm(btn.getAttribute("data-confirm"))) return;
      const id = btn.getAttribute("data-id");
      try {
        const res = await fetch("/api/collections/" + id, { method: "POST", headers: { "Content-Type": "application/json" } });
        if (res.ok) {
          window.location.href = "/collections";
        } else {
          const text = await res.text();
          alert(btn.getAttribute("data-error") + (text ? ": " + text : ""));
        }
      } catch (err) {
        alert(btn.getAttribute("data-error"));
      }
    });
  </script>
</Layout>
