---
import Layout from "../../layouts/Layout.astro";
import NewRecipePage from "../../islands/NewRecipePage";
import { db } from "../../lib/db";
import { tags, collections } from "../../lib/schema";
import { eq } from "drizzle-orm";
import PageHeader from "../../components/PageHeader.astro";
import { SlidersHorizontal } from "lucide-react";
import { t } from "../../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect(`/login?redirect=/recipes/new`);
}

const allTags = db.select({ id: tags.id, name: tags.name }).from(tags).all();
const allCollections = db
  .select({ id: collections.id, name: collections.name })
  .from(collections)
  .where(eq(collections.createdBy, Astro.locals.user.id))
  .all();

const [customizeBefore, customizeAfter = ""] = t("profile.customizeHint").split("{link}");
---

<Layout title={t("nav.newRecipe")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("nav.newRecipe")} description={t("recipe.addSubtitle")}>
      <a slot="actions" href="/profile" class="inline-flex items-center gap-1.5 text-sm text-muted-foreground hover:text-foreground hover:underline underline-offset-4">
        <SlidersHorizontal size={16} strokeWidth={2} />
        {customizeBefore}{t("profile.title").toLowerCase()}{customizeAfter}
      </a>
    </PageHeader>
    <div class="max-w-3xl">
      <NewRecipePage tags={allTags} collections={allCollections} client:load />
    </div>
  </div>
</Layout>
