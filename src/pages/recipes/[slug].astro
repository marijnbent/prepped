---
import { Share, Printer, Copy, Pencil, Trash2, ChevronDown, Link } from "lucide-react";
import Layout from "../../layouts/Layout.astro";
import ServingsScaler from "../../islands/ServingsScaler";
import RecipeChat from "../../islands/RecipeChat";
import RecipeComments from "../../islands/RecipeComments";
import CookLogForm from "../../islands/CookLogForm";
import FavoriteButton from "../../islands/FavoriteButton";
import AddToShoppingListButton from "../../islands/AddToShoppingListButton";
import { db } from "../../lib/db";
import { recipes, cookLogs, recipeComments, recipeTags, tags, recipeCollections, collections, users, favorites } from "../../lib/schema";
import { buildRecipePlainText, formatRecipeIngredientLine, formatRecipeStepLine, formatStepDuration, groupRecipeIngredients } from "../../lib/recipe-export";
import { applyDirkSecretRecipeMode } from "../../lib/recipe-secrets";
import { desc, eq, and } from "drizzle-orm";
import { t, formatDate } from "../../lib/i18n";

const { slug } = Astro.params;

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/recipes/" + slug);
}

// Own recipe: scoped by slug + user
const recipe = db
  .select()
  .from(recipes)
  .where(and(eq(recipes.slug, slug!), eq(recipes.createdBy, Astro.locals.user.id)))
  .get();
if (!recipe) {
  return Astro.redirect("/recipes");
}

// Get tags for this recipe
const recipeTags_ = db
  .select({ name: tags.name, slug: tags.slug })
  .from(recipeTags)
  .innerJoin(recipes, eq(recipeTags.recipeId, recipes.id))
  .innerJoin(tags, eq(recipeTags.tagId, tags.id))
  .where(and(eq(recipeTags.recipeId, recipe.id), eq(recipes.createdBy, recipe.createdBy)))
  .all();

// Get collections for this recipe
const recipeCollections_ = db
  .select({ name: collections.name, slug: collections.slug })
  .from(recipeCollections)
  .innerJoin(collections, eq(recipeCollections.collectionId, collections.id))
  .where(and(eq(recipeCollections.recipeId, recipe.id), eq(collections.createdBy, recipe.createdBy)))
  .all();

// Get cook logs for this recipe (with author name)
const logs = db
  .select({
    id: cookLogs.id,
    photoUrl: cookLogs.photoUrl,
    notes: cookLogs.notes,
    rating: cookLogs.rating,
    cookedAt: cookLogs.cookedAt,
    authorName: users.name,
  })
  .from(cookLogs)
  .leftJoin(users, eq(cookLogs.createdBy, users.id))
  .where(eq(cookLogs.recipeId, recipe.id))
  .orderBy(cookLogs.cookedAt)
  .all();

const comments = db
  .select({
    id: recipeComments.id,
    body: recipeComments.body,
    reaction: recipeComments.reaction,
    createdAt: recipeComments.createdAt,
    authorId: recipeComments.authorId,
    authorName: users.name,
  })
  .from(recipeComments)
  .innerJoin(users, eq(recipeComments.authorId, users.id))
  .where(eq(recipeComments.recipeId, recipe.id))
  .orderBy(desc(recipeComments.createdAt))
  .all()
  .map((comment) => ({ ...comment, createdAt: comment.createdAt.toISOString() }));

// Get recipe author name
const recipeAuthor = recipe.createdBy
  ? db.select({ name: users.name }).from(users).where(eq(users.id, recipe.createdBy)).get()
  : null;

const viewerPreferences = db
  .select({
    cookingSuppliesExpandedByDefault: users.cookingSuppliesExpandedByDefault,
    dirkSecretModeEnabled: users.dirkSecretModeEnabled,
  })
  .from(users)
  .where(eq(users.id, Astro.locals.user.id))
  .get();

// If copied, get the original recipe and its author
const copiedFromSource = recipe.copiedFrom
  ? db
      .select({
        id: recipes.id,
        slug: recipes.slug,
        createdBy: recipes.createdBy,
        authorName: users.name,
      })
      .from(recipes)
      .innerJoin(users, eq(recipes.createdBy, users.id))
      .where(eq(recipes.id, recipe.copiedFrom))
      .get()
  : null;

const isFavorited = !!db
  .select()
  .from(favorites)
  .where(and(eq(favorites.userId, Astro.locals.user.id), eq(favorites.recipeId, recipe.id)))
  .get();

const isOwner = true; // This route is for own recipes only
const baseIngredients = recipe.ingredients as { amount: string; unit: string; name: string; group?: string }[];
const cookingSupplies = (recipe.cookingSupplies as string[] | null) || [];
const baseSteps = recipe.steps as { order: number; instruction: string; duration?: number }[];
const dirkSecretModeEnabled = viewerPreferences?.dirkSecretModeEnabled ?? false;
const { ingredients, steps } = applyDirkSecretRecipeMode({
  ingredients: baseIngredients,
  steps: baseSteps,
  enabled: dirkSecretModeEnabled,
});
const ingredientGroups = groupRecipeIngredients(ingredients);
const cookingSuppliesExpandedByDefault = viewerPreferences?.cookingSuppliesExpandedByDefault ?? false;
const recipePlainText = buildRecipePlainText({
  title: recipe.title,
  ingredients,
  steps,
  notes: recipe.notes,
  labels: {
    ingredients: t("recipe.ingredients"),
    steps: t("recipe.steps"),
    notes: t("recipe.notes"),
    minutes: t("recipe.minutes"),
    hours: t("recipe.hours"),
    toTaste: t("recipe.toTaste"),
  },
});

// Extract YouTube video ID
function getYouTubeId(url: string): string | null {
  const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|shorts\/))([a-zA-Z0-9_-]{11})/);
  return match ? match[1] : null;
}
const youtubeId = recipe.videoUrl ? getYouTubeId(recipe.videoUrl) : null;

// Extract Instagram embed path (e.g. "p/ABC123" or "reel/ABC123")
function getInstagramEmbedPath(url: string): string | null {
  const match = url.match(/instagram\.com\/((?:p|reel)\/[A-Za-z0-9_-]+)/);
  return match ? match[1] : null;
}
const instagramUrl = recipe.videoUrl || recipe.sourceUrl || "";
const instagramEmbedPath = getInstagramEmbedPath(instagramUrl);

// Extract TikTok video ID
function getTikTokVideoId(url: string): string | null {
  const match = url.match(/tiktok\.com\/(?:embed\/v2\/|embed\/|@[^/]+\/video\/)(\d+)/);
  return match ? match[1] : null;
}
const tiktokUrl = recipe.videoUrl || recipe.sourceUrl || "";
const tiktokVideoId = !youtubeId && !instagramEmbedPath ? getTikTokVideoId(tiktokUrl) : null;

const totalTime = (recipe.prepTime || 0) + (recipe.cookTime || 0);
const hasUnsplashAttribution =
  recipe.imageProvider === "unsplash" &&
  recipe.imageAuthorName &&
  recipe.imageAuthorUrl &&
  recipe.imageSourceUrl;
---

<Layout title={recipe.title} description={recipe.description || undefined}>
  <article class="max-w-6xl mx-auto">
    <div class="print-only print-recipe-summary">
      <h1>{recipe.title}</h1>

      <section>
        <h2>{t("recipe.ingredients")}</h2>
        {ingredientGroups.map(({ group, items }) => (
          <>
            {group && <h3>{group}</h3>}
            <ul>
              {items.map((ingredient) => (
                <li>
                  {formatRecipeIngredientLine(ingredient, t("recipe.toTaste"))}
                </li>
              ))}
            </ul>
          </>
        ))}
      </section>

      <section>
        <h2>{t("recipe.steps")}</h2>
        <ol>
          {steps.map((step) => (
            <li>
              {formatRecipeStepLine(step, t("recipe.minutes"), t("recipe.hours")).replace(/^\d+\.\s/, "")}
            </li>
          ))}
        </ol>
      </section>

      {recipe.notes && (
        <section>
          <h2>{t("recipe.notes")}</h2>
          <p>{recipe.notes}</p>
        </section>
      )}
    </div>

    <div class:list={["grid gap-8 lg:gap-14 mb-16 items-center", recipe.imageUrl && "lg:grid-cols-2"]}>
      {recipe.imageUrl && (
        <div class="min-w-0">
          <img src={recipe.imageUrl.startsWith("/") ? `/api/uploads${recipe.imageUrl}` : recipe.imageUrl} alt={recipe.title} class="w-full aspect-[4/5] max-h-[680px] object-cover rounded-[20px]" />
          {hasUnsplashAttribution && <p class="mt-3 text-xs text-muted-foreground">{t("recipe.coverPhotoBy")}{" "}<a href={recipe.imageAuthorUrl!} target="_blank" rel="noreferrer" class="hover:underline">{recipe.imageAuthorName}</a>{" "}{t("recipe.onUnsplash")}{" "}<a href={recipe.imageSourceUrl!} target="_blank" rel="noreferrer" class="hover:underline">Unsplash</a></p>}
        </div>
      )}
      <div class="min-w-0">
        <h1 class="text-4xl sm:text-[44px] xl:text-[52px] font-medium tracking-[-0.04em] leading-none break-words">{recipe.title}</h1>
        <p class="text-muted-foreground mt-5">{[
          totalTime > 0 && formatStepDuration(totalTime, t("recipe.minutes"), t("recipe.hours")),
          recipe.servings && `${recipe.servings} ${t("recipe.people")}`,
          recipe.difficulty && t(`recipe.${recipe.difficulty}` as "recipe.easy" | "recipe.medium" | "recipe.hard").toLocaleLowerCase(),
        ].filter(Boolean).join(", ")}</p>
        {recipe.description && <p class="text-muted-foreground mt-5 mb-6 leading-relaxed max-w-[55ch]">{recipe.description}</p>}
        <p class="text-sm text-muted-foreground my-5">{[recipeAuthor?.name, recipe.createdAt && formatDate(recipe.createdAt)].filter(Boolean).join(", ")}{copiedFromSource && <>{", "}<a href={`/users/${copiedFromSource.createdBy}/recipes/${copiedFromSource.slug}`} class="hover:underline">{t("recipe.copiedFrom")} {copiedFromSource.authorName}</a></>}</p>
        {(recipeCollections_.length > 0 || recipeTags_.length > 0) && (
          <div class="flex flex-wrap gap-2 mb-8">
            {recipeCollections_.map((col) => (
              <a
                href={`/collections/${col.slug}`}
                class="px-3 py-1 rounded-full text-sm border border-border hover:border-foreground"
              >
                {col.name}
              </a>
            ))}
            {recipeTags_.map((tag) => (
              <a
                href={`/tags/${tag.slug}`}
                class="px-3 py-1 rounded-full text-sm border border-border hover:border-foreground"
              >
                {tag.name}
              </a>
            ))}
          </div>
        )}
        <div class="flex flex-wrap gap-x-2 gap-y-3 items-center">
          <div class="w-full mb-1">
            <AddToShoppingListButton recipeId={recipe.id} defaultServings={recipe.servings || 4} showLabel client:load />
          </div>
          {isOwner && (
            <a
              href={`/recipes/${recipe.slug}/edit`}
              class="inline-flex items-center justify-center gap-1.5 h-10 rounded-full border-[1.5px] border-foreground px-[18px] text-sm font-medium hover:bg-secondary"
            >
              <Pencil className="w-4 h-4" strokeWidth={2} aria-hidden="true" />
              {t("recipe.edit")}
            </a>
          )}
          <FavoriteButton recipeId={recipe.id} initialFavorited={isFavorited} client:load />
          <button
            id="share-recipe"
            class="sm:hidden inline-flex items-center justify-center h-10 w-10 rounded-full border border-border hover:bg-secondary"
            aria-label={t("recipe.share")}
          >
            <Share className="w-4 h-4" strokeWidth={2} aria-hidden="true" />
          </button>
          <button
            class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-border hover:bg-secondary"
            aria-label={t("recipe.print")}
            onclick="window.print()"
          >
            <Printer className="w-4 h-4" strokeWidth={2} aria-hidden="true" />
          </button>
          <button
            id="copy-recipe-text"
            class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-border hover:bg-secondary"
            aria-label={t("recipe.copyText")}
            title={t("recipe.copyText")}
            data-copy-label={t("recipe.copyText")}
            data-copied-label={t("recipe.textCopied")}
            data-copy-text={recipePlainText}
            type="button"
          >
            <Copy className="w-4 h-4" strokeWidth={2} aria-hidden="true" />
          </button>
          {isOwner && (
            <button
              id="delete-recipe"
              class="inline-flex items-center justify-center h-10 w-10 rounded-full border border-destructive/30 text-destructive hover:bg-destructive hover:text-destructive-foreground hover:border-destructive"
              onclick={`if(confirm('${t("recipe.deleteConfirm").replace(/'/g, "\\'")}'))fetch('/api/recipes/${recipe.id}',{method:'POST',headers:{'Content-Type':'application/json'}}).then(r=>r.ok?location.href='/recipes':r.text().then(t=>alert('Delete failed: '+(t||r.status)))).catch(e=>alert('Delete failed: '+e.message))`}
            >
              <Trash2 className="w-4 h-4 pointer-events-none" strokeWidth={2} aria-hidden="true" />
              <span class="sr-only">{t("recipe.delete")}</span>
            </button>
          )}
          <span id="copy-recipe-feedback" class="hidden text-xs font-medium" aria-live="polite">
            {t("recipe.textCopied")}
          </span>
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] gap-10 lg:gap-14">
      <div>
        <h2 class="font-medium text-2xl tracking-tight mb-5">{t("recipe.ingredients")}</h2>
        <ServingsScaler
          defaultServings={recipe.servings || 4}
          ingredients={ingredients}
          client:visible
        />
        {cookingSupplies.length > 0 && (
          <details
            class="mt-8 border-t border-border pt-6 group"
            open={cookingSuppliesExpandedByDefault}
          >
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 font-medium text-foreground [&::-webkit-details-marker]:hidden">
              {t("recipe.cookingSupplies")}
              <ChevronDown className="w-4 h-4 text-muted-foreground transition-transform duration-200 group-open:rotate-180" strokeWidth={2} aria-hidden="true" />
            </summary>
            <ul class="mt-4 space-y-2 text-sm text-foreground">
              {cookingSupplies.map((supply) => (
                <li>{supply}</li>
              ))}
            </ul>
          </details>
        )}
      </div>
      <div>
        <h2 class="font-medium text-2xl tracking-tight mb-5">{t("recipe.steps")}</h2>
        <ol class="space-y-8">
          {steps.map((step) => (
            <li class="flex gap-5">
              <span class="text-3xl font-medium leading-none w-8 shrink-0 tabular-nums">{step.order}</span>
              <div class="min-w-0 flex-1">
                <p class="text-base leading-[1.75] max-w-[65ch] text-foreground">{step.instruction}</p>
                {step.duration && (
                  <span class="block text-sm text-muted-foreground mt-2">
                    ~{formatStepDuration(step.duration, t("recipe.minutes"), t("recipe.hours"))}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
    {(recipe.notes || Astro.locals.user) && (
      <div class:list={["mt-16 gap-10", recipe.notes && Astro.locals.user ? "grid grid-cols-1 md:grid-cols-2" : ""]}>
        {recipe.notes && (
          <div class="border-t border-border pt-6">
            <h2 class="font-medium text-xl tracking-tight mb-3">{t("recipe.notes")}</h2>
            <p class="text-sm text-foreground whitespace-pre-wrap leading-relaxed">{recipe.notes}</p>
          </div>
        )}
        {Astro.locals.user && (
          <div class="no-print border-t border-border pt-6">
            <RecipeChat recipeId={recipe.id} title={t("chat.title")} placeholder={t("chat.placeholder")} client:visible />
          </div>
        )}
      </div>
    )}
    {youtubeId && (
      <div class="no-print mt-16">
        <h2 class="font-medium text-xl tracking-tight mb-5">{t("recipe.video")}</h2>
        <div class="aspect-video rounded-[20px] overflow-hidden">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
            title={`${recipe.title} video`}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            class="w-full h-full"
            loading="lazy"
          />
        </div>
      </div>
    )}
    {instagramEmbedPath && !youtubeId && (
      <div class="no-print mt-16">
        <h2 class="font-medium text-xl tracking-tight mb-5">{t("recipe.video")}</h2>
        <div class="flex justify-center">
          <iframe
            src={`https://www.instagram.com/${instagramEmbedPath}/embed/`}
            title={`${recipe.title} video`}
            class="w-full max-w-[400px] rounded-[20px]"
            width="400"
            height="500"
            frameborder="0"
            scrolling="no"
            allowtransparency="true"
            loading="lazy"
          />
        </div>
      </div>
    )}
    {tiktokVideoId && !youtubeId && !instagramEmbedPath && (
      <div class="no-print mt-16">
        <h2 class="font-medium text-xl tracking-tight mb-5">{t("recipe.video")}</h2>
        <div class="flex justify-center">
          <iframe
            src={`https://www.tiktok.com/embed/v2/${tiktokVideoId}`}
            title={`${recipe.title} video`}
            class="h-[740px] w-full max-w-[400px] rounded-[20px]"
            width="400"
            height="740"
            frameborder="0"
            scrolling="no"
            allow="encrypted-media; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      </div>
    )}
    {recipe.sourceUrl && (
      <div class="mt-12 flex items-center gap-2 text-sm text-muted-foreground">
        <Link className="w-3.5 h-3.5 shrink-0" strokeWidth={2} aria-hidden="true" />
        {t("recipe.source")} <a href={recipe.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-foreground hover:underline underline-offset-4 truncate">{recipe.sourceUrl}</a>
      </div>
    )}

    <div class="no-print mt-20">
      <div class="border-t border-border mb-12" />
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
        <RecipeComments
          recipeId={recipe.id}
          initialComments={comments}
          canComment={!!Astro.locals.user}
          loginHref={`/login?redirect=/recipes/${recipe.slug}`}
          client:visible
        />

        <section class="space-y-12">
          {Astro.locals.user && (
            <div>
              <h2 class="font-medium text-2xl tracking-tight mb-6">{t("cookLog.addEntry")}</h2>
              <CookLogForm recipeId={recipe.id} recipeSlug={recipe.slug} client:visible />
            </div>
          )}

          <div>
            <h2 class="font-medium text-2xl tracking-tight mb-4">{t("cookLog.title")}</h2>
            {logs.length > 0 ? (
              <div class="divide-y divide-border">
                {logs.map((log) => (
                  <div class="py-5">
                    <p class="text-sm text-muted-foreground mb-3">
                      {log.authorName && <span class="font-medium text-foreground">{log.authorName}, </span>}
                      <time>{formatDate(log.cookedAt)}</time>{log.rating && `, ${log.rating}/5`}
                    </p>
                    {log.photoUrl && (
                      <img
                        src={log.photoUrl.startsWith("/") ? `/api/uploads${log.photoUrl}` : log.photoUrl}
                        alt={t("cookLog.photoAlt")}
                        class="block w-full rounded-[20px] mb-3 sm:max-w-sm"
                        loading="lazy"
                      />
                    )}
                    {log.notes && <p class="text-foreground leading-relaxed">{log.notes}</p>}
                  </div>
                ))}
              </div>
            ) : (
              <p class="text-sm text-muted-foreground">{t("cookLog.noLogs")}</p>
            )}
          </div>
        </section>
      </div>
    </div>
  </article>

  <script is:inline>
    async function copyText(text) {
      if (navigator.clipboard?.writeText && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return;
      }

      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      textarea.setSelectionRange(0, textarea.value.length);

      const copied = document.execCommand('copy');
      document.body.removeChild(textarea);

      if (!copied) {
        throw new Error('Copy failed');
      }
    }

    function showCopiedState(button) {
      const defaultLabel = button.dataset.copyLabel || button.getAttribute('aria-label') || 'Copy';
      const copiedLabel = button.dataset.copiedLabel || defaultLabel;
      const feedback = document.getElementById('copy-recipe-feedback');

      button.classList.add('text-primary', 'border-primary/50');
      button.setAttribute('aria-label', copiedLabel);
      button.setAttribute('title', copiedLabel);
      feedback?.classList.remove('hidden');

      window.setTimeout(() => {
        button.classList.remove('text-primary', 'border-primary/50');
        button.setAttribute('aria-label', defaultLabel);
        button.setAttribute('title', defaultLabel);
        feedback?.classList.add('hidden');
      }, 1500);
    }

    document.getElementById('share-recipe')?.addEventListener('click', async () => {
      const url = window.location.href;
      const title = document.title;
      try {
        if (navigator.share) {
          await navigator.share({ title, url });
        } else {
          await copyText(url);
          const btn = document.getElementById('share-recipe');
          if (btn) {
            btn.classList.add('text-primary', 'border-primary/50');
            setTimeout(() => btn.classList.remove('text-primary', 'border-primary/50'), 1500);
          }
        }
      } catch {}
    });

    document.getElementById('copy-recipe-text')?.addEventListener('click', async () => {
      const btn = document.getElementById('copy-recipe-text');
      if (!btn) return;

      try {
        await copyText(btn.dataset.copyText || '');
        showCopiedState(btn);
      } catch {}
    });
  </script>
</Layout>
