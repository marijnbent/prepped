---
import Layout from "../../layouts/Layout.astro";
import RecipeSearch from "../../islands/RecipeSearch";
import { db } from "../../lib/db";
import { recipes, recipeCollections, collections, users } from "../../lib/schema";
import { desc, eq, and, ne, inArray } from "drizzle-orm";
import { t } from "../../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/recipes");
}

const userId = Astro.locals.user.id;

// Own recipes
const ownRecipes = db
  .select()
  .from(recipes)
  .where(and(eq(recipes.isPublished, true), eq(recipes.createdBy, userId)))
  .orderBy(desc(recipes.createdAt))
  .all();

// Saved recipes: other users' recipes that are in my collections
const savedRecipes = db
  .selectDistinct({
    id: recipes.id,
    title: recipes.title,
    slug: recipes.slug,
    description: recipes.description,
    imageUrl: recipes.imageUrl,
    prepTime: recipes.prepTime,
    cookTime: recipes.cookTime,
    difficulty: recipes.difficulty,
    createdBy: recipes.createdBy,
    createdByName: users.name,
  })
  .from(recipes)
  .innerJoin(recipeCollections, eq(recipes.id, recipeCollections.recipeId))
  .innerJoin(collections, eq(recipeCollections.collectionId, collections.id))
  .innerJoin(users, eq(recipes.createdBy, users.id))
  .where(and(eq(collections.createdBy, userId), ne(recipes.createdBy, userId)))
  .orderBy(desc(recipes.createdAt))
  .all();

// Build a map of original recipe ID → fork slug for saved recipes the user has forked
const savedRecipeIds = savedRecipes.map((r) => r.id);
const forkMap = new Map<number, string>();
if (savedRecipeIds.length > 0) {
  const forks = db
    .select({ copiedFrom: recipes.copiedFrom, slug: recipes.slug })
    .from(recipes)
    .where(and(eq(recipes.createdBy, userId), inArray(recipes.copiedFrom, savedRecipeIds)))
    .all();
  for (const f of forks) {
    if (f.copiedFrom) forkMap.set(f.copiedFrom, f.slug);
  }
}

// Combine: own recipes first, then saved with a flag
const allRecipes = [
  ...ownRecipes.map((r) => ({
    ...r,
    savedByUser: false,
    createdByName: undefined as string | undefined,
    forkSlug: undefined as string | undefined,
  })),
  ...savedRecipes.map((r) => ({
    ...r,
    savedByUser: true,
    forkSlug: forkMap.get(r.id),
  })),
];

const totalCount = allRecipes.length;

// Community recipes: all published recipes from other users (for search only)
const savedRecipeIdSet = new Set(savedRecipeIds);
const ownRecipeOriginals = new Set(
  ownRecipes.filter((r) => r.copiedFrom).map((r) => r.copiedFrom!)
);
const communityRecipes = db
  .select({
    id: recipes.id,
    title: recipes.title,
    slug: recipes.slug,
    description: recipes.description,
    imageUrl: recipes.imageUrl,
    prepTime: recipes.prepTime,
    cookTime: recipes.cookTime,
    difficulty: recipes.difficulty,
    createdBy: recipes.createdBy,
    authorName: users.name,
  })
  .from(recipes)
  .innerJoin(users, eq(recipes.createdBy, users.id))
  .where(and(eq(recipes.isPublished, true), ne(recipes.createdBy, userId)))
  .orderBy(desc(recipes.createdAt))
  .all()
  .filter((r) => !savedRecipeIdSet.has(r.id) && !ownRecipeOriginals.has(r.id));
---

<Layout title={t("nav.recipes")}>
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-wrap items-end justify-between gap-5 mb-10">
      <h1 class="text-5xl md:text-6xl font-medium tracking-[-0.04em] leading-none">
        {t("nav.recipes")}
        <span class="inline-block align-middle ml-2 text-xl tracking-normal text-muted-foreground">{totalCount}</span>
      </h1>
      {/* The header carries this button from lg up */}
      <a href="/recipes/new" class="lg:hidden inline-flex rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
        {t("nav.newRecipe")}
      </a>
    </div>
    <RecipeSearch
      recipes={allRecipes}
      communityRecipes={communityRecipes}
      searchPlaceholder={t("recipe.search")}
      noResultsText={t("recipe.noRecipes")}
      minutesLabel={t("recipe.minutes")}
      client:load
    />
  </div>
</Layout>
