---
import Layout from "../layouts/Layout.astro";
import ProfileForm from "../islands/ProfileForm.tsx";
import { db } from "../lib/db";
import { users } from "../lib/schema";
import { eq } from "drizzle-orm";
import PageHeader from "../components/PageHeader.astro";
import { t } from "../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/profile");
}

const user = db.select({
  importPrompt: users.importPrompt,
  chatPrompt: users.chatPrompt,
  shoppingPrompt: users.shoppingPrompt,
  cookingSuppliesExpandedByDefault: users.cookingSuppliesExpandedByDefault,
  dirkSecretModeEnabled: users.dirkSecretModeEnabled,
  apiTokenPreview: users.apiTokenPreview,
  apiTokenCreatedAt: users.apiTokenCreatedAt,
  apiTokenLastUsedAt: users.apiTokenLastUsedAt,
})
  .from(users)
  .where(eq(users.id, Astro.locals.user.id))
  .get();
---

<Layout title={t("profile.title")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("profile.title")} />
    <ProfileForm
      client:load
      importPrompt={user?.importPrompt || ""}
      chatPrompt={user?.chatPrompt || ""}
      shoppingPrompt={user?.shoppingPrompt || ""}
      cookingSuppliesExpandedByDefault={user?.cookingSuppliesExpandedByDefault ?? false}
      dirkSecretModeEnabled={user?.dirkSecretModeEnabled ?? false}
      apiTokenPreview={user?.apiTokenPreview || ""}
      apiTokenCreatedAt={user?.apiTokenCreatedAt ? user.apiTokenCreatedAt.toISOString() : ""}
      apiTokenLastUsedAt={user?.apiTokenLastUsedAt ? user.apiTokenLastUsedAt.toISOString() : ""}
    />
  </div>
</Layout>
