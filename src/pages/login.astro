---
import Layout from "../layouts/Layout.astro";
import LoginForm from "../islands/LoginForm";
import { t } from "../lib/i18n";

const rawRedirect = Astro.url.searchParams.get("redirect") || "/";
const redirect = rawRedirect.startsWith("/") && !rawRedirect.startsWith("//")
  ? rawRedirect
  : "/";
const inviteRequired = !!import.meta.env.INVITE_CODE;
const authMode = import.meta.env.AUTH_MODE || "password";
const isSimple = authMode === "simple";

if (Astro.locals.user) {
  return Astro.redirect(redirect);
}
---

<Layout title={t("auth.pageTitle")}>
  <div class="max-w-6xl mx-auto py-8 md:py-16">
    <div class="max-w-sm">
      <h1 class="text-5xl md:text-6xl font-medium tracking-[-0.04em] leading-none">
        {isSimple ? t("auth.whosCooking") : t("auth.welcomeBack")}
      </h1>
      <p class="mt-4 mb-10 text-lg text-muted-foreground">{isSimple ? t("auth.enterName") : t("auth.signInDesc")}</p>
      <LoginForm redirect={redirect} inviteRequired={inviteRequired} authMode={authMode} client:load />
    </div>
  </div>
</Layout>
