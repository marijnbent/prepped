---
import Layout from "../layouts/Layout.astro";
import RecipeCard from "../components/RecipeCard.astro";
import { db } from "../lib/db";
import { favorites, recipes, users } from "../lib/schema";
import { eq, desc } from "drizzle-orm";
import PageHeader from "../components/PageHeader.astro";
import { t } from "../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/favorites");
}

const favoriteRecipes = db
  .select({
    id: recipes.id,
    title: recipes.title,
    slug: recipes.slug,
    description: recipes.description,
    imageUrl: recipes.imageUrl,
    prepTime: recipes.prepTime,
    cookTime: recipes.cookTime,
    difficulty: recipes.difficulty,
    createdBy: recipes.createdBy,
    authorName: users.name,
  })
  .from(favorites)
  .innerJoin(recipes, eq(favorites.recipeId, recipes.id))
  .innerJoin(users, eq(recipes.createdBy, users.id))
  .where(eq(favorites.userId, Astro.locals.user.id))
  .orderBy(desc(favorites.createdAt))
  .all();
---

<Layout title={t("collection.favorites")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader
      title={t("collection.favorites")}
      count={favoriteRecipes.length}
      back={{ href: "/collections", label: t("nav.collections") }}
    />

    {favoriteRecipes.length === 0 ? (
      <div class="py-16">
        <p class="text-xl font-medium">{t("favorites.noFavorites")}</p>
        <p class="text-muted-foreground mt-2">{t("favorites.heartHint")}</p>
        <a href="/recipes" class="inline-flex mt-6 rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
          {t("nav.recipes")}
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
        {favoriteRecipes.map((recipe) => {
          const isOwn = recipe.createdBy === Astro.locals.user!.id;
          return (
            <RecipeCard
              recipe={{ ...recipe, authorName: isOwn ? null : recipe.authorName }}
              href={isOwn ? `/recipes/${recipe.slug}` : `/users/${recipe.createdBy}/recipes/${recipe.slug}`}
              showFavorite
              isFavorited
            />
          );
        })}
      </div>
    )}
  </div>
</Layout>
