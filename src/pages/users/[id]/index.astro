---
import Layout from "../../../layouts/Layout.astro";
import RecipeCard from "../../../components/RecipeCard.astro";
import { db } from "../../../lib/db";
import { users, recipes, collections, recipeCollections } from "../../../lib/schema";
import { eq, and, desc, count, inArray } from "drizzle-orm";
import Avatar from "../../../components/Avatar.astro";
import { ArrowLeft } from "lucide-react";
import { t } from "../../../lib/i18n";

const { id } = Astro.params;
const profileUser = db.select().from(users).where(eq(users.id, id!)).get();
if (!profileUser) {
  return Astro.redirect("/users");
}

const isOwnProfile = Astro.locals.user?.id === profileUser.id;
const userRecipes = db
  .select()
  .from(recipes)
  .where(isOwnProfile
    ? eq(recipes.createdBy, profileUser.id)
    : and(eq(recipes.createdBy, profileUser.id), eq(recipes.isPublished, true))
  )
  .orderBy(desc(recipes.createdAt))
  .all();

const userCollections = db
  .select()
  .from(collections)
  .where(eq(collections.createdBy, profileUser.id))
  .orderBy(collections.sortOrder)
  .all();

// Get recipe counts per collection
const userCollectionIds = userCollections.map((col) => col.id);
const collectionCounts = userCollectionIds.length === 0
  ? []
  : db
      .select({
        collectionId: recipeCollections.collectionId,
        count: count(),
      })
      .from(recipeCollections)
      .where(inArray(recipeCollections.collectionId, userCollectionIds))
      .groupBy(recipeCollections.collectionId)
      .all();
const countsMap = new Map(collectionCounts.map((c) => [c.collectionId, c.count]));

const recipeCountLabel = (n: number) => `${n} ${n === 1 ? t("count.recipe") : t("count.recipes")}`;
---

<Layout title={profileUser.name}>
  <div class="max-w-6xl mx-auto">
    <a href="/users" class="inline-flex items-center gap-1.5 mb-5 text-sm text-muted-foreground hover:underline underline-offset-4">
      <ArrowLeft size={16} strokeWidth={2} />
      {t("nav.community")}
    </a>
    <header class="flex items-center gap-5 mb-12">
      <Avatar name={profileUser.name} image={profileUser.image} class="w-16 h-16 md:w-20 md:h-20 text-xl md:text-2xl" />
      <div class="min-w-0">
        <h1 class="text-5xl md:text-6xl font-medium tracking-[-0.04em] leading-none break-words">{profileUser.name}</h1>
        <p class="text-sm text-muted-foreground mt-3">{recipeCountLabel(userRecipes.length)}</p>
      </div>
    </header>

    {userRecipes.length > 0 ? (
      <section class="mb-20">
        <h2 class="text-2xl font-medium tracking-tight mb-6">{t("user.recipes")}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10">
          {userRecipes.map((recipe) => (
            <RecipeCard recipe={recipe} href={isOwnProfile ? `/recipes/${recipe.slug}` : `/users/${profileUser.id}/recipes/${recipe.slug}`} />
          ))}
        </div>
      </section>
    ) : (
      <div class="mb-20">
        <p class="text-xl font-medium">{t("user.noRecipes")}</p>
        {isOwnProfile && (
          <a href="/recipes/new" class="inline-flex mt-6 rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
            {t("nav.newRecipe")}
          </a>
        )}
      </div>
    )}

    {userCollections.length > 0 && (
      <section class="mb-10">
        <h2 class="text-2xl font-medium tracking-tight mb-3">{t("nav.collections")}</h2>
        <ul class="max-w-2xl divide-y divide-border border-t border-border">
          {userCollections.map((col) => (
            <li>
              <a href={isOwnProfile ? `/collections/${col.slug}` : `/users/${profileUser.id}/collections/${col.slug}`} class="group flex items-baseline justify-between gap-4 py-4">
                <span class="min-w-0">
                  <span class="block font-medium group-hover:underline underline-offset-4">{col.name}</span>
                  {col.description && <span class="block text-sm text-muted-foreground mt-1 line-clamp-1">{col.description}</span>}
                </span>
                <span class="shrink-0 text-sm text-muted-foreground">{recipeCountLabel(countsMap.get(col.id) || 0)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>
