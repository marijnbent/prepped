---
import Layout from "../../layouts/Layout.astro";
import { db } from "../../lib/db";
import { users, recipes } from "../../lib/schema";
import { eq, count } from "drizzle-orm";
import PageHeader from "../../components/PageHeader.astro";
import Avatar from "../../components/Avatar.astro";
import { t } from "../../lib/i18n";

const allUsers = db
  .select({
    id: users.id,
    name: users.name,
    image: users.image,
  })
  .from(users)
  .all();

// Get recipe counts per user
const recipeCounts = db
  .select({
    createdBy: recipes.createdBy,
    count: count(),
  })
  .from(recipes)
  .where(eq(recipes.isPublished, true))
  .groupBy(recipes.createdBy)
  .all();

const countsMap = new Map(recipeCounts.map((r) => [r.createdBy, r.count]));
const members = allUsers
  .map((u) => ({ ...u, recipeCount: countsMap.get(u.id) || 0 }))
  .sort((a, b) => b.recipeCount - a.recipeCount || a.name.localeCompare(b.name));
---

<Layout title={t("nav.community")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("nav.community")} count={members.length} />

    <ul class="max-w-2xl divide-y divide-border border-t border-border">
      {members.map((member) => (
        <li>
          <a href={`/users/${member.id}`} class="group flex items-center gap-4 py-4">
            <Avatar name={member.name} image={member.image} class="w-12 h-12" />
            <span class="min-w-0 flex-1 truncate text-xl font-medium tracking-[-0.025em] group-hover:underline underline-offset-4">
              {member.name}
            </span>
            <span class="shrink-0 text-sm text-muted-foreground">
              {member.recipeCount} {member.recipeCount === 1 ? t("count.recipe") : t("count.recipes")}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
