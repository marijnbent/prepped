---
import Layout from "../layouts/Layout.astro";
import { db } from "../lib/db";
import { cookLogs, recipes, users } from "../lib/schema";
import { desc, eq } from "drizzle-orm";
import PageHeader from "../components/PageHeader.astro";
import { t, formatDate, locale } from "../lib/i18n";

if (!Astro.locals.user) {
  return Astro.redirect("/login?redirect=/cook-log");
}

const logs = db
  .select({
    id: cookLogs.id,
    photoUrl: cookLogs.photoUrl,
    notes: cookLogs.notes,
    rating: cookLogs.rating,
    cookedAt: cookLogs.cookedAt,
    recipeTitle: recipes.title,
    recipeSlug: recipes.slug,
    recipeOwnerId: recipes.createdBy,
    recipeImageUrl: recipes.imageUrl,
    authorName: users.name,
  })
  .from(cookLogs)
  .innerJoin(recipes, eq(cookLogs.recipeId, recipes.id))
  .leftJoin(users, eq(cookLogs.createdBy, users.id))
  .where(eq(cookLogs.createdBy, Astro.locals.user.id))
  .orderBy(desc(cookLogs.cookedAt))
  .all();

const monthFormat = new Intl.DateTimeFormat(locale === "nl" ? "nl-NL" : "en-US", { month: "long", year: "numeric" });
const months: { label: string; logs: typeof logs }[] = [];
for (const log of logs) {
  const label = monthFormat.format(new Date(log.cookedAt));
  const last = months[months.length - 1];
  if (last?.label === label) last.logs.push(log);
  else months.push({ label, logs: [log] });
}

const uploadSrc = (url: string) => (url.startsWith("/") ? `/api/uploads${url}` : url);
---

<Layout title={t("cookLog.title")}>
  <div class="max-w-6xl mx-auto">
    <PageHeader title={t("cookLog.title")} count={logs.length} />

    {logs.length === 0 ? (
      <div class="py-16">
        <p class="text-xl font-medium">{t("cookLog.noLogs")}</p>
        <p class="text-muted-foreground mt-2">{t("cookLog.emptyHint")}</p>
        <a href="/recipes" class="inline-flex mt-6 rounded-full bg-primary px-[18px] py-[9px] text-sm font-medium text-primary-foreground">
          {t("nav.recipes")}
        </a>
      </div>
    ) : (
      <div class="max-w-3xl space-y-14">
        {months.map((month) => (
          <section>
            <h2 class="text-2xl font-medium tracking-tight first-letter:uppercase">{month.label}</h2>
            <div class="mt-3 divide-y divide-border border-t border-border">
              {month.logs.map((log) => (
                <a
                  href={log.recipeOwnerId === Astro.locals.user!.id
                    ? `/recipes/${log.recipeSlug}`
                    : `/users/${log.recipeOwnerId}/recipes/${log.recipeSlug}`}
                  class="group flex items-start gap-5 py-6"
                >
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-medium tracking-[-0.025em] leading-tight group-hover:underline underline-offset-4">{log.recipeTitle}</h3>
                    {log.notes && <p class="text-muted-foreground mt-2 whitespace-pre-line">{log.notes}</p>}
                    <p class="text-sm text-muted-foreground mt-3">
                      <time datetime={new Date(log.cookedAt).toISOString()}>{formatDate(log.cookedAt)}</time>{log.rating && `, ${log.rating}/5`}
                    </p>
                  </div>
                  {log.photoUrl && (
                    <img
                      src={uploadSrc(log.photoUrl)}
                      alt={t("cookLog.photoAlt")}
                      class="w-24 h-24 md:w-32 md:h-32 shrink-0 rounded-[20px] object-cover"
                      loading="lazy"
                    />
                  )}
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    )}
  </div>
</Layout>
